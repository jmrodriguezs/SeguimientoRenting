<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android (Google Drive): datos y preferencias sí; fotos no (límite de 25 MB) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="fotos" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
